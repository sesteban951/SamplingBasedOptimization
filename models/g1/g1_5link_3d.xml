<!--
  MuJoCo MJCF for the 3D 5-link walker.
  Mirrors g1_5link_3d.urdf with an explicit freejoint on the pelvis.
  MuJoCo qpos layout: [px,py,pz, qw,qx,qy,qz, l_roll,l_pitch,l_knee, r_roll,r_pitch,r_knee]
-->
<mujoco model="g1_5link_3d">

  <option gravity="0 0 -9.81"/>

  <worldbody>

    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1" contype="1" conaffinity="1"/>

    <body name="pelvis" pos="0 0 0.689">
      <freejoint name="root_joint"/>
      <inertial pos="0 0 0" mass="22.34"
                fullinertia="2.510 2.209 0.346  0.000 0.058 -0.001"/>

      <!-- LEFT LEG -->
      <body name="l_hip_roll_link" pos="0 0.1185 -0.006">
        <inertial pos="0 0 0" mass="0.001"
                  diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="l_hip_roll" type="hinge" axis="1 0 0"
               range="-0.5 0.5" damping="1.0"/>
        <geom type="sphere" size="0.03" rgba="0.9 0.5 0.1 0.8"/>

        <body name="l_thigh" pos="0 0 0">
          <inertial pos="0 0 -0.1675" mass="3.0"
                    diaginertia="0.0300 0.0300 0.00375"/>
          <joint name="l_hip_pitch" type="hinge" axis="0 1 0"
                 range="-2.5307 2.8798" damping="1.0"/>
          <geom type="capsule" fromto="0 0 0  0 0 -0.335" size="0.035"
                rgba="0.9 0.5 0.1 0.9"/>

          <body name="l_shank" pos="0 0 -0.335">
            <inertial pos="0 0 -0.174" mass="2.5"
                      diaginertia="0.0262 0.0262 0.00200"/>
            <joint name="l_knee_pitch" type="hinge" axis="0 1 0"
                   range="-0.0873 2.8798" damping="1.0"/>
            <geom type="capsule" fromto="0 0 0  0 0 -0.348" size="0.025"
                  rgba="0.95 0.75 0.2 0.9"/>
            <site name="l_foot" pos="0 0 -0.348" size="0.02"/>
          </body>
        </body>
      </body>

      <!-- RIGHT LEG -->
      <body name="r_hip_roll_link" pos="0 -0.1185 -0.006">
        <inertial pos="0 0 0" mass="0.001"
                  diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="r_hip_roll" type="hinge" axis="1 0 0"
               range="-0.5 0.5" damping="1.0"/>
        <geom type="sphere" size="0.03" rgba="0.1 0.6 0.9 0.8"/>

        <body name="r_thigh" pos="0 0 0">
          <inertial pos="0 0 -0.1675" mass="3.0"
                    diaginertia="0.0300 0.0300 0.00375"/>
          <joint name="r_hip_pitch" type="hinge" axis="0 1 0"
                 range="-2.5307 2.8798" damping="1.0"/>
          <geom type="capsule" fromto="0 0 0  0 0 -0.335" size="0.035"
                rgba="0.1 0.6 0.9 0.9"/>

          <body name="r_shank" pos="0 0 -0.335">
            <inertial pos="0 0 -0.174" mass="2.5"
                      diaginertia="0.0262 0.0262 0.00200"/>
            <joint name="r_knee_pitch" type="hinge" axis="0 1 0"
                   range="-0.0873 2.8798" damping="1.0"/>
            <geom type="capsule" fromto="0 0 0  0 0 -0.348" size="0.025"
                  rgba="0.2 0.85 0.95 0.9"/>
            <site name="r_foot" pos="0 0 -0.348" size="0.02"/>
          </body>
        </body>
      </body>

      <!-- torso capsule (visual only) -->
      <geom type="capsule" fromto="0 0 -0.05  0 0 0.25" size="0.07"
            rgba="0.35 0.55 0.85 0.9" contype="0" conaffinity="0"/>

    </body>

  </worldbody>

</mujoco>
